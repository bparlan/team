#!/usr/bin/env python3
"""
Phase 4: Loop Management System

Comprehensive loop management system with independent inits and stable cycling capabilities.
Provides deterministic execution of team discussions and tasks with robust state management,
error recovery, and performance monitoring.
"""

import os
import json
import time
import threading
import uuid
import logging
from datetime import datetime, timezone, timedelta
from typing import Dict, Any, List, Optional, Callable, Set, Union
from enum import Enum, auto
from dataclasses import dataclass, asdict
from collections import deque, defaultdict
import json
import time
import threading
import uuid
import logging

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)
class LoopPhase(Enum):
    """Loop execution phases."""
    IDLE = auto()
    INITIALIZING = auto()
    RUNNING = auto()
    PAUSED = auto()
    COMPLETING = auto()
    ERROR = auto()
class LoopStatus(Enum):
    """Overall loop status."""
    STOPPED = "stopped"
    STARTING = "starting"
    RUNNING = "running"
    PAUSED = "paused"
    STOPPING = "stopping"
    ERROR = "error"
class LoopPriority(Enum):
    """Loop execution priority levels."""
    CRITICAL = 10
    HIGH = 5
    NORMAL = 0
    LOW = -5
    BACKGROUND = -10
class LoopEventType(Enum):
    """Loop event types for event-driven architecture."""
    LOOP_STARTED = auto()
    LOOP_STOPPED = auto()
    LOOP_PAUSED = auto()
    LOOP_RESUMED = auto()
    LOOP_ERROR = auto()
    PHASE_STARTED = auto()
    PHASE_COMPLETED = auto()
    TASK_STARTED = auto()
    TASK_COMPLETED = auto()
    TASK_FAILED = auto()
    CYCLE_COMPLETED = auto()
@dataclass
class LoopConfig:
    """Loop configuration settings."""
    loop_id: str
    name: str
    description: str
    priority: LoopPriority = LoopPriority.NORMAL
    max_retries: int = 3
    timeout_seconds: int = 300
    monitoring_interval: int = 60
    auto_recovery: bool = True
    persistence_enabled: bool = True
    event_driven: bool = True
@dataclass
@dataclass
class LoopPhaseDefinition:
    """Phase definition for loop execution."""
    phase_id: str
    name: str
    description: str
    order: int
    tasks: List[str]
    dependencies: List[str] = None
    parallel: bool = False

    def __post_init__(self):
        if self.dependencies is None:
            self.dependencies = []
@dataclass
class LoopStatistics:
    """Loop performance statistics."""
    tasks_executed: int = 0
    tasks_completed: int = 0
    tasks_failed: int = 0
    total_execution_time: float = 0.0
    current_cycle: int = 0
    total_cycles: int = 0
    start_time: Optional[datetime] = None
    last_cycle_time: Optional[float] = None
@dataclass
class LoopEvent:
    """Loop event for event-driven architecture."""
    event_id: str
    event_type: LoopEventType
    timestamp: datetime
    source: str
    data: Dict[str, Any]

    def to_dict(self) -> Dict[str, Any]:
        return {
            "event_id": self.event_id,
            "event_type": self.event_type.name,
            "timestamp": self.timestamp.isoformat(),
            "source": self.source,
            "data": self.data
        }
class LoopEventManager:
    """Manages loop events for event-driven architecture."""

    def __init__(self, loop_id: str):
        self.loop_id = loop_id
        self.event_handlers: Dict[LoopEventType, List[Callable]] = defaultdict(list)
        self.event_history: deque = deque(maxlen=1000)
        self.lock = threading.RLock()

    def add_event_handler(self, event_type: LoopEventType, handler: Callable):
        """Add event handler."""
        with self.lock:
            self.event_handlers[event_type].append(handler)

    def emit_event(self, event_type: LoopEventType, data: Dict[str, Any], source: str = None):
        """Emit event."""
        event = LoopEvent(
            event_id=str(uuid.uuid4()),
            event_type=event_type,
            timestamp=datetime.now(timezone.utc),
            source=source or self.loop_id,
            data=data
        )

        with self.lock:
            self.event_history.append(event)

        # Trigger handlers
        for handler in self.event_handlers.get(event_type, []):
            try:
                handler(event)
            except Exception as e:
                logger.error(f"Event handler error for {event_type}: {e}")

    def get_recent_events(self, event_type: LoopEventType = None, limit: int = 100) -> List[LoopEvent]:
        """Get recent events."""
        with self.lock:
            events = list(self.event_history)
            if event_type:
                events = [e for e in events if e.event_type == event_type]
            return list(events)[:limit]
class LoopStateManager:
    """Manages loop state and persistence."""

    def __init__(self, loop_id: str, persistence_enabled: bool = True):
        self.loop_id = loop_id
        self.state_file = os.path.join(
            os.getcwd(), ".mp", "theteam", "loop_states", f"{loop_id}.json"
        )
        self.persistence_enabled = persistence_enabled

        # In-memory state
        self.phase = LoopPhase.IDLE
        self.status = LoopStatus.STOPPED
        self.current_phase = None
        self.current_task_id = None
        self.cycle_count = 0
        self.task_queue = deque()
        self.completed_tasks = set()
        self.failed_tasks = set()
        self.blocked_tasks = set()
        self.active_sessions: Dict[str, Dict[str, Any]] = {}

        # Statistics
        self.statistics = LoopStatistics()

        # Event manager
        self.event_manager = LoopEventManager(loop_id)

        # Load persisted state
        if self.persistence_enabled:
            self.load_state()

    def load_state(self) -> bool:
        """Load loop state from persistence."""
        try:
            if os.path.exists(self.state_file):
                with open(self.state_file, 'r') as f:
                    state = json.load(f)

                self.phase = LoopPhase[state.get('phase', 'IDLE')]
                self.status = LoopStatus(state.get('status', 'STOPPED'))
                self.current_phase = state.get('current_phase')
                self.current_task_id = state.get('current_task_id')
                self.cycle_count = state.get('cycle_count', 0)
                self.completed_tasks = set(state.get('completed_tasks', []))
                self.failed_tasks = set(state.get('failed_tasks', []))
                self.blocked_tasks = set(state.get('blocked_tasks', []))

                # Convert task queue
                self.task_queue = deque(state.get('task_queue', []))

                # Convert statistics
                stats_data = state.get('statistics', {})
                self.statistics = LoopStatistics(
                    tasks_executed=stats_data.get('tasks_executed', 0),
                    tasks_completed=stats_data.get('tasks_completed', 0),
                    tasks_failed=stats_data.get('tasks_failed', 0),
                    total_execution_time=stats_data.get('total_execution_time', 0.0),
                    current_cycle=stats_data.get('current_cycle', 0),
                    total_cycles=stats_data.get('total_cycles', 0),
                    start_time=datetime.fromisoformat(stats_data.get('start_time', '').replace('Z', '+00:00')) if stats_data.get('start_time') else None,
                    last_cycle_time=stats_data.get('last_cycle_time')
                )

                self.active_sessions = state.get('active_sessions', {})

                logger.info(f"Loaded loop state for {self.loop_id}")
                return True
        except Exception as e:
            logger.error(f"Failed to load loop state for {self.loop_id}: {e}")

        return False

    def save_state(self) -> bool:
        """Save loop state to persistence."""
        if not self.persistence_enabled:
            return True

        try:
            os.makedirs(os.path.dirname(self.state_file), exist_ok=True)

            state = {
                'phase': self.phase.name,
                'status': self.status.value,
                'current_phase': self.current_phase,
                'current_task_id': self.current_task_id,
                'cycle_count': self.cycle_count,
                'completed_tasks': list(self.completed_tasks),
                'failed_tasks': list(self.failed_tasks),
                'blocked_tasks': list(self.blocked_tasks),
                'task_queue': list(self.task_queue),
                'statistics': asdict(self.statistics),
                'active_sessions': self.active_sessions,
                'last_saved': datetime.now(timezone.utc).isoformat()
            }

            with open(self.state_file, 'w') as f:
                json.dump(state, f, indent=2)

            logger.debug(f"Saved loop state for {self.loop_id}")
            return True
        except Exception as e:
            logger.error(f"Failed to save loop state for {self.loop_id}: {e}")
            return False

    def update_status(self, phase: LoopPhase, status: LoopStatus):
        """Update loop status and save state."""
        self.phase = phase
        self.status = status
        self.save_state()
class LoopManager:
    """
    Phase 4: Loop Management System

    Provides deterministic execution of team discussions and tasks with robust state management,
    error recovery, and performance monitoring.

    Key Features:
    - Modular phase-based execution
    - Independent component inits
    - Stable cycling capabilities
    - Event-driven architecture
    - Comprehensive error handling and recovery
    - Performance monitoring and metrics
    """

    def __init__(self, config: LoopConfig):
        self.config = config
        self.state_manager = LoopStateManager(config.loop_id, config.persistence_enabled)
        self.tasks: Dict[str, UnifiedTask] = {}
        self.phases: Dict[str, LoopPhaseDefinition] = {}
        self.running_tasks: Dict[str, threading.Thread] = {}
        self.lock = threading.RLock()
        self.monitoring_thread = None
        self.shutdown_requested = False

        # Register default event handlers
        self._register_default_event_handlers()

        logger.info(f"Initialized LoopManager for {config.name} (ID: {config.loop_id})")

    def _register_default_event_handlers(self):
        """Register default event handlers."""
        self.state_manager.event_manager.add_event_handler(
            LoopEventType.PHASE_STARTED,
            self._handle_phase_started
        )
        self.state_manager.event_manager.add_event_handler(
            LoopEventType.PHASE_COMPLETED,
            self._handle_phase_completed
        )
        self.state_manager.event_manager.add_event_handler(
            LoopEventType.TASK_FAILED,
            self._handle_task_failed
        )
        self.state_manager.event_manager.add_event_handler(
            LoopEventType.CYCLE_COMPLETED,
            self._handle_cycle_completed
        )

    def add_task(self, task: UnifiedTask):
        """Add a task to the loop."""
        with self.lock:
            self.tasks[task.task_id] = task
            self.state_manager.task_queue.append(task.task_id)
            logger.info(f"Added task {task.task_id} ({task.name}) to loop")

    def add_phase(self, phase: LoopPhaseDefinition):
        """Add a phase definition."""
        with self.lock:
            self.phases[phase.phase_id] = phase
            logger.info(f"Added phase {phase.phase_id} ({phase.name}) to loop")

    def start(self):
        """Start the loop."""
        with self.lock:
            if self.state_manager.status != LoopStatus.STOPPED:
                logger.warning(f"Cannot start loop {self.config.name} - current status: {self.state_manager.status}")
                return False

            self.state_manager.update_status(LoopPhase.INITIALIZING, LoopStatus.STARTING)
            self.state_manager.statistics.start_time = datetime.now(timezone.utc)
            self.state_manager.event_manager.emit_event(
                LoopEventType.LOOP_STARTED,
                {"loop_id": self.config.loop_id, "name": self.config.name},
                "loop_manager"
            )

            # Start monitoring thread
            self.monitoring_thread = threading.Thread(
                target=self._monitoring_loop,
                daemon=True
            )
            self.monitoring_thread.start()

            self.state_manager.update_status(LoopPhase.RUNNING, LoopStatus.RUNNING)
            logger.info(f"Started loop {self.config.name}")
            return True

    def pause(self):
        """Pause the loop."""
        with self.lock:
            if self.state_manager.status != LoopStatus.RUNNING:
                return False

            self.state_manager.update_status(LoopPhase.PAUSED, LoopStatus.PAUSED)
            self.state_manager.event_manager.emit_event(
                LoopEventType.LOOP_PAUSED,
                {"loop_id": self.config.loop_id},
                "loop_manager"
            )
            logger.info(f"Paused loop {self.config.name}")
            return True

    def resume(self):
        """Resume the loop."""
        with self.lock:
            if self.state_manager.status != LoopStatus.PAUSED:
                return False

            self.state_manager.update_status(LoopPhase.RUNNING, LoopStatus.RUNNING)
            self.state_manager.event_manager.emit_event(
                LoopEventType.LOOP_RESUMED,
                {"loop_id": self.config.loop_id},
                "loop_manager"
            )
            logger.info(f"Resumed loop {self.config.name}")
            return True

    def stop(self):
        """Stop the loop."""
        with self.lock:
            if self.state_manager.status == LoopStatus.STOPPED:
                return True

            self.state_manager.update_status(LoopPhase.COMPLETING, LoopStatus.STOPPING)
            self.shutdown_requested = True

            # Stop all running tasks
            for task_id in list(self.running_tasks.keys()):
                self._stop_task(task_id)

            self.state_manager.update_status(LoopPhase.IDLE, LoopStatus.STOPPED)
            self.state_manager.event_manager.emit_event(
                LoopEventType.LOOP_STOPPED,
                {"loop_id": self.config.loop_id},
                "loop_manager"
            )

            # Wait for monitoring thread to complete
            if self.monitoring_thread and self.monitoring_thread.is_alive():
                self.monitoring_thread.join(timeout=5.0)

            logger.info(f"Stopped loop {self.config.name}")
            return True

    def _monitoring_loop(self):
        """Background monitoring loop."""
        while not self.shutdown_requested:
            try:
                time.sleep(self.config.monitoring_interval)
                self._perform_monitoring()
            except Exception as e:
                logger.error(f"Monitoring loop error: {e}")

    def _perform_monitoring(self):
        """Perform periodic monitoring tasks."""
        status = self.get_status()

        # Log metrics
        if status['statistics']['tasks_executed'] > 0:
            completion_rate = (
                status['statistics']['tasks_completed'] /
                status['statistics']['tasks_executed'] * 100
            )
            logger.info(f"Loop {self.config.name} - "
                       f"Tasks: {status['statistics']['tasks_executed']}, "
                       f"Completed: {status['statistics']['tasks_completed']}, "
                       f"Failed: {status['statistics']['tasks_failed']}, "
                       f"Completion Rate: {completion_rate:.1f}%")

        # Check for stuck tasks
        self._check_stuck_tasks()

    def _check_stuck_tasks(self):
        """Check for tasks that might be stuck."""
        current_time = time.time()
        for task_id, thread in self.running_tasks.items():
            # Check if thread is alive but has been running for too long
            if thread.is_alive():
                task = self.tasks.get(task_id)
                if task:
                    # This is a simplified check - in reality, you'd need more sophisticated monitoring
                    pass

    def _handle_phase_started(self, event: LoopEvent):
        """Handle phase started event."""
        phase_id = event.data.get('phase_id')
        logger.info(f"Phase {phase_id} started for loop {self.config.name}")

    def _handle_phase_completed(self, event: LoopEvent):
        """Handle phase completed event."""
        phase_id = event.data.get('phase_id')
        logger.info(f"Phase {phase_id} completed for loop {self.config.name}")

    def _handle_task_failed(self, event: LoopEvent):
        """Handle task failed event."""
        task_id = event.data.get('task_id')
        error = event.data.get('error', 'Unknown error')
        logger.warning(f"Task {task_id} failed in loop {self.config.name}: {error}")

    def _handle_cycle_completed(self, event: LoopEvent):
        """Handle cycle completed event."""
        cycle = event.data.get('cycle', 0)
        logger.info(f"Cycle {cycle} completed for loop {self.config.name}")

    def _stop_task(self, task_id: str) -> bool:
        """Stop a running task."""
        if task_id not in self.running_tasks:
            return False

        thread = self.running_tasks[task_id]
        thread.join(timeout=5.0)
        del self.running_tasks[task_id]
        return True

    def get_status(self) -> Dict[str, Any]:
        """Get loop status."""
        with self.lock:
            return {
                'loop_id': self.config.loop_id,
                'name': self.config.name,
                'phase': self.state_manager.phase.name,
                'status': self.state_manager.status.value,
                'current_phase': self.state_manager.current_phase,
                'current_task_id': self.state_manager.current_task_id,
                'cycle_count': self.state_manager.cycle_count,
                'statistics': asdict(self.state_manager.statistics),
                'tasks_total': len(self.tasks),
                'tasks_queue_size': len(self.state_manager.task_queue),
                'tasks_running': len(self.running_tasks),
                'tasks_completed': len(self.state_manager.completed_tasks),
                'tasks_failed': len(self.state_manager.failed_tasks)
            }

    def get_task_status(self, task_id: str) -> Optional[Dict[str, Any]]:
        """Get status of a specific task."""
        return self.tasks.get(task_id)

    def get_all_tasks(self) -> List[Dict[str, Any]]:
        """Get all tasks."""
        with self.lock:
            return [asdict(task) for task in self.tasks.values()]

    def get_all_phases(self) -> List[Dict[str, Any]]:
        """Get all phases."""
        with self.lock:
            return [asdict(phase) for phase in self.phases.values()]

    def get_event_history(self, event_type: LoopEventType = None, limit: int = 100) -> List[Dict[str, Any]]:
        """Get event history."""
        return [
            event.to_dict() for event in self.state_manager.event_manager.get_recent_events(event_type, limit)
        ]

    def save_state(self):
        """Save loop state."""
        return self.state_manager.save_state()
class LoopManagerFactory:
    """Factory for creating LoopManager instances with different configurations."""

    @staticmethod
    def create_default_loop(project_root: str) -> LoopManager:
        """Create a default loop with standard configuration."""
        config = LoopConfig(
            loop_id=f"loop_{int(time.time())}",
            name="Default Team Loop",
            description="Default loop for team discussions and task execution",
            priority=LoopPriority.NORMAL,
            max_retries=3,
            timeout_seconds=300,
            monitoring_interval=60,
            auto_recovery=True,
            persistence_enabled=True,
            event_driven=True
        )
        return LoopManager(config)

    @staticmethod
    def create_production_loop(project_root: str) -> LoopManager:
        """Create a production loop with enhanced configuration."""
        config = LoopConfig(
            loop_id=f"prod_loop_{int(time.time())}",
            name="Production Loop",
            description="Production loop with high reliability and monitoring",
            priority=LoopPriority.HIGH,
            max_retries=5,
            timeout_seconds=600,
            monitoring_interval=30,
            auto_recovery=True,
            persistence_enabled=True,
            event_driven=True
        )
        return LoopManager(config)

    @staticmethod
    def create_discussion_loop(project_root: str) -> LoopManager:
        """Create a discussion-focused loop."""
        config = LoopConfig(
            loop_id=f"disc_loop_{int(time.time())}",
            name="Discussion Loop",
            description="Loop focused on team discussions and knowledge sharing",
            priority=LoopPriority.NORMAL,
            max_retries=2,
            timeout_seconds=900,
            monitoring_interval=120,
            auto_recovery=True,
            persistence_enabled=True,
            event_driven=True
        )
        return LoopManager(config)
    """
    Module-level functions for simple usage
    """

    def create_loop_manager(project_root: str, loop_type: str = "default") -> LoopManager:
        """Simple function to create a loop manager."""
        if loop_type == "production":
            return LoopManagerFactory.create_production_loop(project_root)
        elif loop_type == "discussion":
            return LoopManagerFactory.create_discussion_loop(project_root)
        else:
            return LoopManagerFactory.create_default_loop(project_root)
def main():
    """Demo function for loop manager."""
    import sys

    project_root = sys.argv[1] if len(sys.argv) > 1 else "./"

    # Create loop manager
    loop_manager = create_loop_manager(project_root)

    # Create some sample tasks
    def sample_task_1():
        print("  Executing Task 1: Data processing")
        time.sleep(0.5)
        return {"status": "completed", "result": "Processed 1000 records"}

    def sample_task_2():
        print("  Executing Task 2: Analysis")
        time.sleep(0.3)
        return {"status": "completed", "result": "Generated analysis report"}

    def sample_task_3():
        print("  Executing Task 3: Validation")
        time.sleep(0.7)
        return {"status": "completed", "result": "Validation passed"}

    task1 = UnifiedTask(
        task_id="task1",
        name="Data Processing",
        description="Process incoming data records",
        priority=LoopPriority.HIGH,
        phase="data_processing"
    )

    task2 = UnifiedTask(
        task_id="task2",
        name="Analysis",
        description="Analyze processed data",
        priority=LoopPriority.NORMAL,
        phase="analysis"
    )

    task3 = UnifiedTask(
        task_id="task3",
        name="Validation",
        description="Validate analysis results",
        priority=LoopPriority.LOW,
        phase="validation"
    )

    loop_manager.add_task(task1)
    loop_manager.add_task(task2)
    loop_manager.add_task(task3)

    # Create sample phases
    data_phase = LoopPhaseDefinition(
        phase_id="data_processing",
        name="Data Processing",
        description="Process and validate incoming data",
        order=1,
        tasks=["task1"],
        parallel=False
    )

    analysis_phase = LoopPhaseDefinition(
        phase_id="analysis",
        name="Analysis",
        description="Perform data analysis",
        order=2,
        tasks=["task2"],
        parallel=False
    )

    validation_phase = LoopPhaseDefinition(
        phase_id="validation",
        name="Validation",
        description="Validate and finalize results",
        order=3,
        tasks=["task3"],
        parallel=False
    )

    loop_manager.add_phase(data_phase)
    loop_manager.add_phase(analysis_phase)
    loop_manager.add_phase(validation_phase)

    print(f"Loop Manager initialized for {project_root}")
    print(f"Loop ID: {loop_manager.config.loop_id}")
    print(f"Name: {loop_manager.config.name}")
    print(f"Description: {loop_manager.config.description}")
    print()

    print("Tasks added:")
    for task in loop_manager.get_all_tasks():
        print(f"  • {task['name']} (ID: {task['task_id']}) - Priority: {task['priority']}")

    print()
    print("Phases added:")
    for phase in loop_manager.get_all_phases():
        print(f"  • {phase['name']} (ID: {phase['phase_id']}) - Order: {phase['order']}")

    print()
    print("Starting loop...")
    loop_manager.start()

    print("\nRunning for 15 seconds...")
    time.sleep(15)

    print("\nPausing...")
    loop_manager.pause()
    time.sleep(5)

    print("\nResuming...")
    loop_manager.resume()
    time.sleep(5)

    print("\nStopping...")
    loop_manager.stop()

    status = loop_manager.get_status()
    print("\n=== Final Status ===")
    print(f"Phase: {status['phase']}")
    print(f"Status: {status['status']}")
    print(f"Tasks Executed: {status['statistics']['tasks_executed']}")
    print(f"Tasks Completed: {status['statistics']['tasks_completed']}")
    print(f"Tasks Failed: {status['statistics']['tasks_failed']}")
    print(f"Current Cycle: {status['statistics']['current_cycle']}")

    print("\n✓ Loop Manager demo completed")
if __name__ == "__main__":
    main()