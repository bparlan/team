{
  "title": "theteam Production",
  "uid": "theteam-prod",
  "tags": [
    "theteam"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": null,
      "title": "Health Score",
      "type": "stat",
      "datasource": {
        "uid": "theteam-prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "theteam-prometheus",
            "type": "prometheus"
          },
          "expr": "theteam_health_score",
          "legendFormat": "",
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "/.*/"
        },
        "show": "all",
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
