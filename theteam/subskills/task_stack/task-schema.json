{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "type", "phases"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "type": {"enum": ["one-shot", "loop", "scheduled", "conversation"]},
    "priority": {"enum": ["low", "medium", "high", "critical"]},
    "schedule": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["interval", "cron", "once"]},
        "interval_minutes": {"type": "integer"},
        "cron_expression": {"type": "string"}
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "script"],
        "properties": {
          "name": {"type": "string"},
          "script": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "timeout_seconds": {"type": "integer"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": {"type": "string"},
          "type": {"type": "string"}
        }
      }
    },
    "team_review": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "required_verdicts": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
