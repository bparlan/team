# TheTeam runtime state
team/.omp/
team/.mp/
team/context/
team/.team/
# Runtime audit / event logs
.loop-log/

# Analysis output, not source: rewritten on every run and capped at 2MB by
# SystemArchitectureAnalyzer.save_ledger. It reached 25MB in git.
system-awareness-ledger.json
archives/

# Analysis outputs: regenerated by every `theteam run system-awareness`.
health_score.json
team_summary.json
architecture_report.json
documentation_report.json
infrastructure_report.json
optimization_report.json

# Loop runtime state: derived, rewritten by every analysis run and read by
# `project-integrity` and `loop_health_check.py`, which require it to exist and
# to be fresh. `_load_state` writes a default when the file is absent, so a
# fresh clone works without it.
.loop-state.json

# Timestamped analysis output: one file per run, unbounded in count. Scoped to
# the machine-stamped names only — the hand-authored reports beside them
# (architecture-analysis.md, designer-ui-ux-insights.md, …) stay tracked, and an
# earlier blanket `theteam/reports/` rule would have silently dropped all 47.
theteam/reports/system-architecture-analysis-*.md
theteam/reports/theteam-synthesis-*.json
theteam/reports/health_score-*.json
theteam/reports/optimization_recommendations-*.md
#
# 34 files matching these patterns are still tracked from before the rule
# existed; .gitignore only stops new ones. They stay tracked deliberately — they
# are the analysis history, and a 2026-09-21 baseline is worth having. So
# `git ls-files`, not this file, is the authority on what is tracked.

# Harness-written runtime state, committed before the ignore rules existed.
# Untracked with `git rm --cached`; the files stay on disk because
# theteam/core/{state_manager,wal,event_log,event_bus}.py recreate them.
wal.json
events.jsonl
test_events.jsonl

# Test-harness SQLite: theteam/core/database.py recreates it. Committed empty
# (no tables) — it was never a fixture, only a leftover.
test.db
test.wal

